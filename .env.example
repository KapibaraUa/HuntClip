# Скопируй в .env и впиши ключ. .env не коммитится.
GEMINI_API_KEY=
# Модель и режим
GEMINI_MODEL=gemini-3.8-flash
AGENTIC_MODE=false
THINKING_LEVEL=medium
# Допустимые значения разрешения: low | medium | high | unspecified
MEDIA_RES_SCAN=low
MEDIA_RES_REFINE=high
REFINE_FPS=1.0
# Нарезка на куски (секунды)
CHUNK_S=2700
OVERLAP_S=120
SHORT_VIDEO_MAX_S=2700
PAD_BEFORE_S=30
PAD_AFTER_S=30
SNAP_S=1.0
CLIP_MIN_S=20
CLIP_MAX_S=90
CLIP_TOLERANCE_S=5
# Ограничения кандидатов
MAX_CANDIDATES_PER_HOUR=20
MAX_PER_30MIN=6
JUDGE_BATCH=10
LLM_CONCURRENCY=2
# Бюджет и цены, USD за 1M токенов
# gemini-3.8-flash, Standard, вводные цены действуют до 2026-12-31;
# с 2027-01-01: вход 1.50, выход 7.50. Токены мышления считаются как выходные.
MAX_COST_USD_PER_JOB=5.0
CONFIRM_ABOVE_USD=1.0
PRICE_IN_PER_M=0.75
PRICE_OUT_PER_M=3.75
# Предположения по токенам видео (из документации; уточняются калибровкой)
TOKENS_PER_SEC_LOW=100
TOKENS_PER_SEC_HIGH=300
CONTEXT_TOKENS=1000000
CONTEXT_SHARE_MAX=0.6
# Результаты калибровки (пока значения по умолчанию, не измерены)
URL_OFFSETS_OK=false
URL_TS_RELATIVE_TO_WINDOW=true
# Калибровка: жёсткий потолок трат на весь прогон (USD)
CALIBRATION_MAX_COST_USD=1.0
# Поведение
AUTO_RENDER=false
SUBTITLES=false
CAPCUT_EXPORT=false
USE_NVENC=false
FFMPEG_TIMEOUT_S=900
# Хранилище и сервисы
DATA_DIR=data
RETENTION_DAYS=14
# По умолчанию автономная SQLite БД (для PostgreSQL в Docker: postgresql+psycopg://cliphunter:cliphunter@localhost:5432/cliphunter)
DATABASE_URL=sqlite+aiosqlite:///data/cliphunter.db
REDIS_URL=redis://localhost:6379/0
# Telegram (фаза 6)
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_IDS=
# Логи
LOG_LEVEL=INFO
